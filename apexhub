		return false
	end
	local NH = RS:FindFirstChild("NeedleHaystack")
	local vote = NH and NH:FindFirstChild("ReplayVote")
	if not vote then
		return false
	end
	local t, voted = os.clock(), false
	while os.clock() - t < 40 and enabled() do
		local ui = lp.PlayerGui:FindFirstChild("NeedleEndingUI")
		local panel = ui and ui:FindFirstChild("ReturnToLobby")
		if panel and panel.Visible and lp:GetAttribute("ReplayVoted") ~= true and vote:GetAttribute("Launching") ~= true then
			pcall(function()
				vote:FireServer(true)
			end)
			if not voted then
				voted = true
				say("replaying")
			end
		end
		task.wait(1)
	end
