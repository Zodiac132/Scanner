do
	local slotFocusSlot, slotFocusAt = nil, 0
	local function slotFocusPos(s)
		local g, c = slotGeo, Config.PILE_CENTER
		return Vector3.new(g.sx[s], c.Y + SurfaceMod.baseHeight(g.sx[s] - c.X, g.sz[s] - c.Z), g.sz[s])
	end
	slotFocus = function()
		local g = slotGeo
		if slotFocusSlot and not g.covered[slotFocusSlot] and os.clock() - slotFocusAt < 0.3 then
			return slotFocusPos(slotFocusSlot)
		end
		local root = hrp()
		if not root then
			return nil
		end
		local c, p = Config.PILE_CENTER, root.Position
		local lx, lz = p.X - c.X, p.Z - c.Z
		local best, bestD
		for _, cell in ipairs(g.list) do
			if cell.unc > 0 then
				local dx = math.max(cell.cx - lx, 0, lx - cell.cx - 1)
				local dz = math.max(cell.cz - lz, 0, lz - cell.cz - 1)
				if not bestD or dx * dx + dz * dz < bestD then
					for _, s in ipairs(cell.slots) do
						if not g.covered[s] then
							local ex, ez = g.sx[s] - p.X, g.sz[s] - p.Z
							local d = ex * ex + ez * ez
							if not bestD or d < bestD then
								best, bestD = s, d
							end
						end
					end
				end
			end
		end
		slotFocusSlot, slotFocusAt = best, os.clock()
		return best and slotFocusPos(best)
	end
