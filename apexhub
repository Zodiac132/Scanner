		if not setupOpen() then
			if hum then
				hum:MoveTo(root.Position + (root.Position - center).Unit * 10)
			end
			task.wait(2)
			continue
		end
		local map, diff = pickMapAndDifficulty(PartyConfig)
		say(("starting a solo round: %s %s"):format(map, diff))
		PartyClient.networker:fire("CreateParty", map, 1, diff)
		setupUI.Visible = false
		t0 = os.clock()
		while enabled() and os.clock() - t0 < 18 do
			task.wait(0.5)
		end
		if not enabled() then
			break
		end
		say("the round didn't start, trying again")
		pcall(function()
			PartyClient.networker:fire("LeaveParty")
		end)
		task.wait(2)
	end
