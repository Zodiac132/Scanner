	local best, bestN, bestD
	for _, cell in ipairs(g.list) do
		if cell.unc > 0 then
			local x, z = c.X + cell.cx + 0.5, c.Z + cell.cz + 0.5
			local d = math.sqrt((x - from.X) ^ 2 + (z - from.Z) ^ 2)
			if d > 6 and d < 23 then
				local n = slotScore(x, z, R)
				if not bestN or n > bestN or (n == bestN and d < bestD) then
					local aim = surfaceAim(x, z)
					if throwVelocity(from, aim) then
						best, bestN, bestD = aim, n, d
