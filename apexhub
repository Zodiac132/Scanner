local function merchantOptions()
	local ok, mc = pcall(function()
		return require(game:GetService("ReplicatedStorage").Shared.Configs.MerchantConfig)
	end)
	local out = { "*" }
	if ok and type(mc.Prices) == "table" then
		for id in pairs(mc.Prices) do
			table.insert(out, id)
		end
	else
		local ok2, ac = pcall(function()
			return require(game:GetService("ReplicatedStorage").PetAccessories.AccessoryConfig)
		end)
		if ok2 and type(ac.Accessories) == "table" then
			for id in pairs(ac.Accessories) do
				table.insert(out, id)
			end
		end
	end
	table.sort(out)
	return out
end
local TOOLS = { "Pitchfork", "Dynamite", "Vacuum", "Drone" }
local function mapOptions()
	local ok, pc = pcall(function()
		return require(game:GetService("ReplicatedStorage").Shared.Configs.PartyConfig)
	end)
	if ok and type(pc.GetMapsInOrder) == "function" then
		local ok2, maps = pcall(pc.GetMapsInOrder)
		if ok2 and type(maps) == "table" then
			local out = {}
			for _, m in ipairs(maps) do
				table.insert(out, type(m) == "table" and m.Name or tostring(m))
			end
			if #out > 0 then
				return out
			end
		end
	end
	return { "FARMHOUSE", "BASEMENT", "RANCH", "GRAVEYARD" }
end
local function difficultyOptions()
	local ok, pc = pcall(function()
		return require(game:GetService("ReplicatedStorage").Shared.Configs.PartyConfig)
	end)
	if ok and type(pc.Difficulties) == "table" then
		local list = table.clone(pc.Difficulties)
		table.sort(list, function(a, b)
			return (a.Order or 0) < (b.Order or 0)
		end)
		local out = {}
		for _, d in ipairs(list) do
			table.insert(out, d.Name)
		end
		if #out > 0 then
			return out
		end
	end
	return { "NORMAL", "HARD" }
end
