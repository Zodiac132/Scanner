			for _ = 1, size + 2 do
				local cur = equippedPet(petState())
				local lowest
				for pos in pairs(cur and cur.Worn or {}) do
					local p = tonumber(pos)
					if p and (not lowest or p < lowest) then
						lowest = p
					end
				end
				if not lowest then
					break
				end
				PetMenu:InvokeServer({ Action = "SetAccessory", PetId = pet.Id, AccessoryId = "", Position = lowest })
				task.wait(0.3)
			end
			for i, id in ipairs(set) do
