			table.insert(list, { part = e.part, g = g, f = e.f })
		end
	end
	table.sort(list, function(a, b)
		if a.g ~= b.g then
			return a.g < b.g
		end
		return a.f < b.f
	end)
	stripCache, stripAt = list, os.clock()
