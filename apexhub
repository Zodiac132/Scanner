	sweepLastHand = primary.Position
	return primary, ids
end
local function slotFork()
	local g, slotOf = slotGeo, slotTrack.slotOf
	local r = (g.forkR or Config.PITCHFORK_DIG_RADIUS or 1.55) + g.cover
	local best, bestN
	for _, e in ipairs(nearbyHay()) do
		local part = e.part
		if e.d <= PICK_RANGE and liveStrand(part) and (not sweepLastHand or (part.Position - sweepLastHand).Magnitude > 3) then
			local s = slotOf[part:GetAttribute("HayId")]
			local pos = part.Position
			local x, z = pos.X, pos.Z
			if s then
				x, z = g.sx[s], g.sz[s]
			end
			local n = slotScore(x, z, r)
			if n > 0 and (not bestN or n > bestN) then
				best, bestN = part, n
			end
		end
	end
	return best
end
