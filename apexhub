local function sellThreshold()
	return tonumber(opt("SellBelow", "0")) or 0
end
local function sellJunk()
	local limit = sellThreshold()
	if limit <= 0 then
		return 0
	end
	local inSlot, keys = plotted(), {}
	for key, item in pairs(d(Data.Inventory) or {}) do
		local ch = chanceOf(item)
		if ch and ch < limit and not inSlot[key] and not (item.attributes and item.attributes.locked) then
			table.insert(keys, key)
		end
	end
	if #keys == 0 then
		return 0
	end
	local got, n = R.SellInventory:InvokeServer(keys)
	if (tonumber(n) or 0) > 0 then
		State.sold += n
		State.soldMoney += tonumber(got) or 0
		note(("Sold %d common units for $%s"):format(n, fmt(got)))
	end
	return tonumber(n) or 0
end
local function sellWorst()
	if not on("SellWorstWhenFull") then
		return 0
	end
	local need = -storageLeft() + opt("FreeSpace", 10)
	if need <= 0 then
		return 0
	end
	local keep = plotted()
	for _, k in pairs(d(Data.TowerTeam) or {}) do
		keep[k] = true
	end
	local keepRarer = tonumber(opt("KeepRarer", "1000000")) or 1e6
	local list = {}
	for key, item in pairs(d(Data.Inventory) or {}) do
		local c = unitCfg(item)
		local ch = chanceOf(item)
		if c and ch and ch < keepRarer and not keep[key] and not (item.attributes and item.attributes.locked) then
			table.insert(list, { key = key, income = tonumber(d(c.income, item.attributes)) or 0 })
		end
	end
	table.sort(list, function(a, b)
		return a.income < b.income
	end)
	local keys = {}
	for i = 1, math.min(need, #list) do
		keys[i] = list[i].key
	end
	if #keys == 0 then
		return 0
	end
	local got, n = R.SellInventory:InvokeServer(keys)
	n = tonumber(n) or 0
	if n > 0 then
		State.sold += n
		State.soldMoney += tonumber(got) or 0
		note(("Inventory was full: sold your %d weakest units for $%s"):format(n, fmt(got)))
	end
	return n
end
local function makeRoom()
	if storageLeft() > 0 then
		return true
	end
	sellJunk()
	if storageLeft() > 0 then
		return true
	end
	sellWorst()
	return storageLeft() > 0
end
