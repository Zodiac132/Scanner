	if typeof(target) ~= "Vector3" then
		log("truck: no EndPosition to drive to")
		return
	end
	local startPos = truck:GetPivot().Position
	local goal = Vector3.new(target.X, startPos.Y + 2, target.Z)
	local duration = (goal - startPos).Magnitude / 40
	local parts = {}
	for _, p in ipairs(truck:GetDescendants()) do
		if p:IsA("BasePart") then
			table.insert(parts, p)
		end
	end
	log(("truck: driving %.0f studs to the exit"):format((goal - startPos).Magnitude))
	getgenv().Apex_NeedleMoveLock = true
	local t0 = os.clock()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		local a = math.min((os.clock() - t0) / duration, 1)
		local pos = startPos:Lerp(goal, a)
		local look = Vector3.new(goal.X, pos.Y, goal.Z)
		if (look - pos).Magnitude > 1 then
			truck:PivotTo(CFrame.lookAt(pos, look))
		end
		for _, p in ipairs(parts) do
			p.AssemblyLinearVelocity = Vector3.zero
			p.AssemblyAngularVelocity = Vector3.zero
		end
		if a >= 1 then
			conn:Disconnect()
		end
	end)
	while conn.Connected do
		task.wait(0.2)
	end
	local t = os.clock()
	while os.clock() - t < 15 and finish:GetAttribute("Finished") ~= true do
		task.wait(0.5)
	end
