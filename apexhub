local function round()
	say("in a round")
	RS:WaitForChild("NeedleHaystack", 60)
	hrp()
	local t = os.clock()
	while lp:GetAttribute("IntroCutsceneFinished") ~= true and os.clock() - t < 40 do
		task.wait(0.25)
	end
	task.wait(0.5)
	getgenv().Apex_AutoHay = false
	local farmFailed = false
	task.spawn(function()
		local ok, err = pcall(APEX_MOD("autohay"))
		if not ok then
			farmFailed = true
			say("farm error: " .. tostring(err))
		end
	end)
	say("farming")
	if APEX.premium and workspace:FindFirstChild("UfoSplitted") and workspace:FindFirstChild("HayGolem_Rig") and setting("ranch.enabled") then
		task.spawn(function()
			pcall(APEX_MOD("ranch"))
		end)
	end
	if APEX.premium and workspace:FindFirstChild("HayCandles") and workspace:FindFirstChild("PumpkinGolem_Rig") and setting("graveyard.enabled") then
		task.spawn(function()
			pcall(APEX_MOD("graveyard"))
		end)
	end
	if APEX.premium and workspace:FindFirstChild("Puzzles") and RS:FindFirstChild("Puzzles") and setting("puzzles.enabled") then
		task.spawn(function()
			task.wait(5)
			pcall(APEX_MOD("puzzles"))
		end)
	end
	if setting("needle.marker") then
		task.spawn(function()
			pcall(APEX_MOD("needlemarker"))
		end)
	end
	local started = os.clock()
	local function totalHay()
		local ok, v = pcall(function()
			return tonumber(require(RS.Shared.Services.Data).client.TotalHayCollected())
		end)
		return ok and v or nil
	end
	local hayStart, hayCheckAt, hayDone, roundDone, finishing = totalHay(), 0, false, false, nil
	while enabled() do
		local hayMode = APEX.premium and not setting("needle.enabled")
		local restartAt = tonumber(setting("afk.hayOnlyRestartAt")) or 0
		if finishing and os.clock() - finishing > (tonumber(setting("afk.hayFinishTimeout")) or 120)
			and lp:GetAttribute("NeedleRoundComplete") ~= true then
			getgenv().Apex_HayFinishNeedle = false
			getgenv().Apex_AutoHay = false
			hayDone = true
			break
		end
		if hayMode and restartAt > 0 and not finishing and hayStart and os.clock() - hayCheckAt > 2 then
			hayCheckAt = os.clock()
			local now = totalHay()
			if now and now - hayStart >= restartAt then
				if setting("afk.hayFinishWithNeedle") and setting("afk.replay") then
					finishing = os.clock()
					getgenv().Apex_HayFinishNeedle = true
					say("hay target reached: finishing the round with the needle")
				else
					getgenv().Apex_AutoHay = false
					hayDone = true
					break
				end
			end
		end
		if lp:GetAttribute("NeedleRoundComplete") == true then
			say("round over")
			roundDone = true
			break
		end
		if os.clock() - started > (tonumber(setting("afk.maxRoundMinutes")) or 45) * 60 or farmFailed then
			break
		end
		task.wait(0.1)
	end
	if not enabled() then
		getgenv().Apex_AutoHay = false
		return
	end
	local function gemsOnGround()
		local f = workspace:FindFirstChild("GemsClient")
		for _, c in ipairs(f and f:GetChildren() or {}) do
			if c:IsA("Model") and c.Name:sub(1, 4) == "Gem_" then
				return true
			end
		end
		return false
	end
	local t2 = os.clock()
	while os.clock() - t2 < (tonumber(setting("afk.endWait")) or 3) do
		task.wait(0.25)
		if os.clock() - t2 >= 1.25 and not gemsOnGround() then
			break
		end
	end
	getgenv().Apex_AutoHay = false
	if roundDone and tryReplay() then
		return
	end
	returnToLobby(hayDone)
end
task.spawn(function()
	while AFK.alive do
		if not setting("afk.enabled") then
			AFK.state = "off"
			task.wait(1)
			continue
		end
		local ok, err = pcall(function()
			if RS:FindFirstChild("NeedleHaystack") then
