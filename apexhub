local revealNote, revealRadiusLog
do
	local revealRecs, revealNoteUntil = {}, 0
	revealNote = function(kind, uid, removed, newIds)
		if removed == nil or (haveSaidRevealed and os.clock() > revealNoteUntil) then
			return
		end
		local now, last = os.clock(), revealRecs[#revealRecs]
		local rec = last
		if not (kind == "hand" and last and last.kind == "hand" and last.uid == uid and now - last.t < 0.05) then
			rec = { t = now, kind = kind, uid = uid, ids = {}, news = {} }
			table.insert(revealRecs, rec)
			if #revealRecs > 60 then
				table.remove(revealRecs, 1)
			end
		end
		if type(removed) == "table" then
			for i, id in ipairs(removed) do
				table.insert(rec.ids, id)
				rec.news[#rec.ids] = type(newIds) == "table" and newIds[i] or nil
			end
		else
			table.insert(rec.ids, removed)
			rec.news[#rec.ids] = newIds
		end
	end
	local function revealSnapshot()
		local snap = {}
		local ok, st = pcall(function()
			return GetHayState:InvokeServer()
		end)
		if ok and type(st) == "table" and type(st.activeIds) == "table" and type(st.activeSlots) == "table" then
			for i, hid in pairs(st.activeIds) do
				snap[hid] = st.activeSlots[i]
			end
		end
		return snap
	end
	local function revealSlotLookup(snap)
		local nextOf = {}
		for _, r in ipairs(revealRecs) do
			for i, id in ipairs(r.ids) do
				nextOf[id] = r.news[i]
			end
		end
		return function(id)
			local s = slotTrack and slotTrack.slotOf[id]
			for _ = 1, 8 do
				if s or type(id) ~= "number" then
					break
				end
				s, id = snap[id], nextOf[id]
			end
			return s
		end
	end
	local function revealRecText(r, npos, nx, nz, revealT, slotFor)
		local best, bestS, known = nil, nil, 0
		for _, id in ipairs(r.ids) do
			local p = posCache[id]
			if p and npos then
				local d = flat(p - npos).Magnitude
				best = math.min(best or d, d)
			end
			local s = nx and slotFor(id)
			if s then
				local x, z = slotXZ(s)
				local d = math.sqrt((x - nx) ^ 2 + (z - nz) ^ 2)
				bestS, known = math.min(bestS or d, d), known + 1
			end
		end
		local function num(v)
			return v and ("%.2f"):format(v) or "?"
		end
		local dt = r.t - revealT
		return ("tool=%s nearest=%s slot=%s (request removed %d, %d slots known, dt %s%.2fs%s)"):format(r.kind, num(best),
			num(bestS), #r.ids, known, dt >= 0 and "+" or "-", math.abs(dt), r.uid == lp.UserId and "" or ", other player")
	end
	local function sweepModeName()
		return sweep.startedAt and (slotGeo and "slots" or "lattice") or "none"
	end
	local function revealRadiusWrite(id, revealT, snap)
		local prev, nxt
		for _, r in ipairs(revealRecs) do
			if r.t <= revealT then
				prev = r
			elseif not nxt then
				nxt = r
			end
		end
		prev = prev and revealT - prev.t <= 1 and prev or nil
		nxt = nxt and nxt.t - revealT <= 0.3 and nxt or nil
		if not (prev or nxt) then
			needleLog("reveal radius: no removal echo within 1s before / 0.3s after the reveal | mode=" .. sweepModeName())
			return
		end
		local npos = posCache[id]
		for _, p in ipairs(workspace.HaystackClient:GetChildren()) do
			if p:GetAttribute("HayId") == id then
				npos = p.Position
				break
			end
		end
		local slotFor = revealSlotLookup(snap)
		local ns = slotFor(id)
		local nx, nz
		if ns then
			nx, nz = slotXZ(ns)
		end
		local out = {}
		if prev then
			table.insert(out, revealRecText(prev, npos, nx, nz, revealT, slotFor))
		end
		if nxt then
			table.insert(out, "next: " .. revealRecText(nxt, npos, nx, nz, revealT, slotFor))
		end
		needleLog("reveal radius: " .. table.concat(out, " | ") .. " | mode=" .. sweepModeName())
	end
	revealRadiusLog = function(id, revealT, fromEvent)
		if not fromEvent then
			needleLog("reveal radius: skipped (the poller saw the reveal first, its time is unknown) | mode=" .. sweepModeName())
			return
		end
		revealNoteUntil = revealT + 0.4
		task.spawn(function()
			local snap = revealSnapshot()
			task.wait(math.max(revealT + 0.5 - os.clock(), 0))
			local ok, err = pcall(revealRadiusWrite, id, revealT, snap)
			if not ok then
				needleLog("reveal radius: error " .. tostring(err))
			end
		end)
	end
end
