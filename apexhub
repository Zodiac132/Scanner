local function loop(every, fn)
	task.spawn(function()
		while State.alive and not Library.Unloaded do
			local ok, err = pcall(fn)
			if not ok then
				note("something went wrong (it will retry): " .. tostring(err):sub(1, 80))
				task.wait(2)
			end
			local w = type(every) == "function" and every() or every
			task.wait(w)
		end
	end)
