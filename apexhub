		if cost and not skip[id] and id ~= "Drone" and (APEX.premium or id == "Pitchfork") then
			local o2 = table.clone(owned)
			o2[id] = true
			table.insert(list, { kind = "tool", id = id, cost = cost, balance = balance, gain = digRate(lv, o2) - base })
		end
	end
	for id in pairs(Config.UPGRADE_TRACKS) do
		local cost = nextCost(id)
		if cost and not skip[id] and (APEX.premium or id:sub(1, 9) == "Pitchfork") then
			local lv2 = table.clone(lv)
