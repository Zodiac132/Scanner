local function searchTarget(goalDepth, avoidPos, avoidR)
	local root = hrp()
	local center = Config.PILE_CENTER
	if not (lastDig and root and center) then
		return nil
	end
	local N = Surface.GRID_N
	local best, bestD
	for idx = 1, Surface.NODE_COUNT do
		local x = Surface.nodeCoordinate((idx - 1) % N + 1)
		local z = Surface.nodeCoordinate(math.floor((idx - 1) / N) + 1)
		local base = Surface.baseHeight(x, z)
		if base > 0.5 then
			local goal = math.min(goalDepth, Config.DIG_MAX_DEPTH or 3.2, base * 0.8)
			local dug = lastDig[idx] or 0
			if dug < goal - 0.05 then
				local wp = Vector3.new(center.X + x, center.Y + base - dug, center.Z + z)
				local d = flat(wp - root.Position).Magnitude
				local away = not avoidPos or flat(wp - avoidPos).Magnitude >= avoidR
				if away and (not bestD or d < bestD) then
					best, bestD = wp, d
				end
			end
		end
	end
	return best
end
