local function bestPurchase()
	local list = candidates()
	local okP, prio = pcall(setting, "buy.priority")
	for _, prefix in ipairs(okP and type(prio) == "table" and prio or {}) do
		local pick
		for _, c in ipairs(list) do
			if c.id:sub(1, #prefix) == prefix and (not pick or c.cost < pick.cost) then
				pick = c
			end
		end
		if pick then
			return pick
		end
	end
	local best, bestScore
	for _, c in ipairs(list) do
		if c.gain > 0.01 then
			local score = c.gain / math.max(c.cost, 0.01)
			if not bestScore or score > bestScore then
				best, bestScore = c, score
			end
		end
	end
	if best then
		return best
	end
	for _, c in ipairs(list) do
		if not best or c.cost < best.cost then
			best = c
		end
	end
	return best
end
