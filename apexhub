local function digRate(lv, owned)
	local hand = (levelStat("Grab", lv.Grab, "Count") or 1) / ((levelStat("Speed", lv.Speed, "Cooldown") or 0.55) + 0.05)
	local fork = 0
	if owned.Pitchfork then
		fork = (levelStat("Pitchfork", lv.Pitchfork, "Scoop") or 12) * classStat("PitchforkScoopMultiplier")
			/ ((levelStat("PitchforkCooldown", lv.PitchforkCooldown, "Cooldown") or 0.85) + 0.05)
	end
	local tnt = 0
	if owned.Tnt then
		local r = (levelStat("TntPower", lv.TntPower, "Radius") or 2.1) * classStat("BlastRadiusMultiplier")
		tnt = TNT_HAY_PER_AREA * r * r / ((levelStat("TntCooldown", lv.TntCooldown, "Cooldown") or 20) + 0.65)
	end
	local vac, slot = 0, fork
	if owned.Vacuum then
		local per = (levelStat("VacuumPower", lv.VacuumPower, "Count") or 5) * classStat("VacuumGrabMultiplier")
		local run = levelStat("VacuumRuntime", lv.VacuumRuntime, "Duration") or 30
		local cool = (levelStat("VacuumCooling", lv.VacuumCooling, "Cooldown") or 20) * classStat("VacuumCooldownMultiplier")
		vac = per / Config.VACUUM_TICK * VACUUM_EFFICIENCY
		if vac > fork then
			local duty = run / (run + cool)
			slot = duty * vac + (1 - duty) * fork
		end
	end
	local dig = hand + tnt + slot
	if not owns("InfiniteBagOwned") then
		local curLvl = tonumber(lp:GetAttribute("HayUpgradeCapacity")) or 1
		local curBase = levelStat("Capacity", curLvl, "Capacity") or 25
		local scale = (tonumber(lp:GetAttribute("HayCapacity")) or curBase) / curBase
		local cap = (levelStat("Capacity", lv.Capacity, "Capacity") or 25) * scale
		dig = dig / (1 + dig * SELL_OVERHEAD / math.max(cap, 1))
	end
	if owned.Drone then
		local grab = levelStat("DroneGrab", lv.DroneGrab, "Count") or 6
		local speed = (levelStat("DroneSpeed", lv.DroneSpeed, "FlightSpeed") or 12.5) * classStat("DroneFlightSpeedMultiplier")
		local cap = (levelStat("DroneCapacity", lv.DroneCapacity, "Capacity") or 36) * classStat("DroneCapacityMultiplier")
		local flight = DRONE_FLIGHT_BASE * DRONE_SPEED_BASE / speed
		local visit = Config.DRONE_HARVEST_PAUSE + flight
		local sellTrip = Config.DRONE_SELL_PAUSE + flight
		dig += grab / (visit + sellTrip * grab / math.max(cap, grab))
	end
	return dig, fork, vac
end
