		end)
		for _, item in ipairs(stock) do
			local _, now = bestSet(owned, size)
			local with = table.clone(owned)
			with[item.Id] = true
			local _, after = bestSet(with, size)
			if not item.Owned and not owned[item.Id] and item.Gems and after > now * 1.01
				and item.Gems <= setting("merchant.maxPrice") and gems() - item.Gems >= reserve then
