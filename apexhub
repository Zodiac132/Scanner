local REAL = {}
for _, name in ipairs({ "readfile", "writefile", "appendfile", "isfile", "delfile", "isfolder", "makefolder" }) do
	REAL[name] = getgenv()[name] or _G[name]
end
local function mapPath(p)
	return tostring(p)
end
local function keepWrite(p)
	return p:find("^ApexHub/Needle/settings_%d+%.json$") ~= nil
end
local function ensure(p)
	local dir = p:match("^(.*)/[^/]*$")
	if dir and REAL.isfolder and REAL.makefolder then
		local acc = ""
		for part in dir:gmatch("[^/]+") do
			acc = acc == "" and part or (acc .. "/" .. part)
			if not REAL.isfolder(acc) then
				REAL.makefolder(acc)
			end
		end
	end
end
local FS = {
	readfile = function(p)
		return REAL.readfile(mapPath(p))
	end,
	isfile = function(p)
		return REAL.isfile ~= nil and REAL.isfile(mapPath(p))
	end,
	isfolder = function(p)
		return REAL.isfolder ~= nil and REAL.isfolder(mapPath(p))
	end,
	makefolder = function(p)
		ensure(mapPath(p) .. "/x")
	end,
	writefile = function(p, c)
		p = mapPath(p)
		if keepWrite(p) then
			ensure(p)
			return REAL.writefile(p, c)
		end
	end,
	appendfile = function() end,
	delfile = function() end,
}
