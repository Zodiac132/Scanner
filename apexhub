	for _, e in ipairs(list) do
		if e.d <= PICK_RANGE and liveStrand(e.part) then
			local p = sweepPointFor(e.part.Position)
			if p then
				primary, pp = e.part, p
				break
			end
		end
	end
	if not primary then
		return nil
	end
	sweepReq[primary:GetAttribute("HayId")] = pp
	local ids, chosen, used = {}, {}, { [pp] = true }
	local covers = { pp }
	if count > 1 and radius > 0 then
		for _, e in ipairs(list) do
			if #ids >= count - 1 then
				break
			end
			local part = e.part
			if part ~= primary and (part.Position - primary.Position).Magnitude <= radius and liveStrand(part) then
				local p = sweepPointFor(part.Position)
				if p and not used[p] then
					used[p] = true
					table.insert(covers, p)
					local hid = part:GetAttribute("HayId")
					table.insert(ids, hid)
					sweepReq[hid] = p
					chosen[part] = true
				end
			end
		end
		if #ids < count - 1 then
			for _, id in ipairs(grabCandidates(primary)) do
				if #ids >= count - 1 then
					break
				end
				if not table.find(ids, id) then
					table.insert(ids, id)
				end
			end
		end
	end
	local now = os.clock()
	for _, p in ipairs(covers) do
		p.pending = now
	end
