	box:AddButton({ Text = "Get key (copies the link)", Func = function()
		local url = APEX.keyUrl()
		if url then
			pcall(setclipboard, url)
			Library:Notify({ Title = "Apex Hub", Description = "Key link copied - paste it in your browser", Time = 5 })
		else
			Library:Notify({ Title = "Apex Hub", Description = "Couldn't reach the key system, try again in a minute", Time = 5 })
		end
	end })
	box:AddInput("ApexKeyInput", { Text = "Your key", Default = "", Placeholder = "Paste your key here", Finished = false })
	box:AddButton({ Text = "Check key", Func = function()
		local input = Library.Options.ApexKeyInput and Library.Options.ApexKeyInput.Value or ""
		local ok, keyOrWhy = APEX.checkKey(input)
		if not ok then
			Library:Notify({ Title = "Apex Hub", Description = keyOrWhy, Time = 6 })
			return
		end
		saveKey(keyOrWhy)
		Library:Notify({ Title = "Apex Hub", Description = "Key accepted! Unlocking everything...", Time = 4 })
		task.delay(1, function()
			APEX.unload()
			APEX.premium = true
			APEX.tierName = "Premium (key)"
			APEX.start()
		end)
	end })
end
function APEX.start()
	if game.GameId == NEEDLE_GAME then
		APEX_MOD("needle_ui")()
	elseif game.PlaceId == ANIME_DICE_PLACE then
		APEX_MOD("animedice")()
	else
		warn("[Apex Hub] This game isn't supported (yet). Supported: Search For The Needle, Anime Dice.")
	end
end
APEX.start()
