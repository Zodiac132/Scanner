local function slotGreedyIds(primary, list, taken, want, radius)
	local g, slotOf = slotGeo, slotTrack.slotOf
	local cands = {}
	for _, e in ipairs(list) do
		local part = e.part
		if part ~= primary and (part.Position - primary.Position).Magnitude <= radius and liveStrand(part) then
			local id = part:GetAttribute("HayId")
			local s = slotOf[id]
			local gain = s and slotGain(g.sx[s], g.sz[s], g.cover, taken, false) or 0
			if gain > 0 then
				table.insert(cands, { id = id, s = s, gain = gain })
			end
		end
	end
	local ids = {}
	while #ids < want do
		local best
		for _, c in ipairs(cands) do
			if c.gain > 0 and (not best or c.gain > best.gain) then
				best = c
			end
		end
		if not best then
			break
		end
		local gain = slotGain(g.sx[best.s], g.sz[best.s], g.cover, taken, false)
		if gain == best.gain then
			slotGain(g.sx[best.s], g.sz[best.s], g.cover, taken, true)
			best.gain = 0
			table.insert(ids, best.id)
		else
			best.gain = gain
		end
	end
	if #ids < want then
		for _, id in ipairs(grabCandidates(primary)) do
			if #ids >= want then
				break
			end
			if not table.find(ids, id) then
				table.insert(ids, id)
			end
		end
	end
	return ids
end
local function slotGreedy(primary, ps, list)
