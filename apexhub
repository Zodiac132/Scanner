	slotGain(g.sx[ps], g.sz[ps], g.cover, taken, true)
	local ids = {}
	if count > 1 and radius > 0 then
		ids = slotGreedyIds(primary, list, taken, count - 1, radius)
	end
	local now = os.clock()
	for s in pairs(taken) do
		g.pend[s] = now
	end
	return ids
end
local function slotHand()
	local g, slotOf = slotGeo, slotTrack.slotOf
