local function solveNumber(s)
	local c = cfg("NumberPuzzle")
	local folder = Folder:FindFirstChild("NumberPuzzle")
	if not folder then
		return
	end
	local code = type(s.code) == "string" and s.code or nil
	local feedback = PuzzleFeedback.OnClientEvent:Connect(function(id, kind, index, found, got)
		if id == "NumberPuzzle" and kind == "Poster" and type(got) == "string" then
			code = got
		end
	end)
	local indexAttr = PuzzleConfig.PosterIndexAttribute or "PosterIndex"
	local taken = {}
	for k, v in pairs(s.taken or {}) do
		if v then
			taken[tonumber(k)] = true
		end
	end
	local candidates = {}
	local posters = folder:FindFirstChild(c.Posters or "Posters")
	for _, p in ipairs(posters and posters:GetChildren() or {}) do
		local idx = p:GetAttribute(indexAttr)
		if idx and p:IsA("BasePart") and not taken[idx] then
			candidates[idx] = p.Position
		end
	end
	pcall(function()
		for _, f in ipairs(getgc(false)) do
			if type(f) == "function" and islclosure(f) and debug.info(f, "n") == "openPoster"
				and tostring(debug.info(f, "s")):find("NumberPuzzleClient") then
				local u9 = debug.getupvalues(f)[1]
				for idx, part in pairs(type(u9) == "table" and u9 or {}) do
					if typeof(part) == "Instance" and not taken[idx] then
						candidates[idx] = candidates[idx] or part.Position
					end
				end
				break
			end
		end
	end)
	local tries = {}
	local opened, lastOpen = 0, 0
	local POSTER_GAP = 1.5
	while not code do
		local root = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		local best, bestPos, bd
		for idx, pos in pairs(candidates) do
			if not taken[idx] and (tries[idx] or 0) < 3 and root then
				local d = (pos - root.Position).Magnitude
				if not bd or d < bd then
					best, bestPos, bd = idx, pos, d
				end
			end
		end
		if not best then
			break
		end
		tries[best] = (tries[best] or 0) + 1
		sellIfFull()
		Move.to(bestPos, tries[best] == 1 and 5 or 3, 20)
		local wait = POSTER_GAP - (os.clock() - lastOpen)
		if wait > 0 then
			task.wait(wait)
		end
		local answered = false
		local c2 = PuzzleFeedback.OnClientEvent:Connect(function(id, kind, index)
			if id == "NumberPuzzle" and kind == "Poster" and index == best then
				answered = true
			end
		end)
		PuzzleAction:FireServer("NumberPuzzle", "Poster", best)
		lastOpen = os.clock()
		local t = os.clock()
		while not answered and not code and os.clock() - t < 2 do
			task.wait(0.05)
		end
		c2:Disconnect()
		if answered then
			taken[best] = true
			opened += 1
		end
	end
	feedback:Disconnect()
	if not code then
		log(("number: no code found after %d posters"):format(opened))
		return
	end
	log(("number: code %s (after %d posters)"):format(code, opened))
	local keypad = folder:FindFirstChild(c.Keypad or "Keypad", true)
	if keypad then
		moveNear(keypad:GetPivot().Position, c.InteractDistance or 10)
		PuzzleAction:FireServer("NumberPuzzle", "Submit", code)
		task.wait(1.5)
	end
end
