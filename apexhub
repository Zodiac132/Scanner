local ALL_STATS = AccessoryConfig.BuffStatOrder or { "WalkSpeed", "Capacity", "TakeAmount" }
local function accessoryScore(id)
	local a = AccessoryConfig.Accessories and AccessoryConfig.Accessories[id]
	if type(a) ~= "table" then
		return 0
	end
	local w = STAT_WEIGHTS[setting("pets.accessoryScoring")] or STAT_WEIGHTS.overall
	local buffs = type(a.Buffs) == "table" and a.Buffs or {}
	local score = 0
	local all = tonumber(buffs.All) or 0
	for _, stat in ipairs(ALL_STATS) do
		score += all * (w[stat] or 0)
	end
	for stat, amount in pairs(buffs) do
		if stat ~= "All" and type(amount) == "number" then
			score += amount * (w[stat] or 0)
		end
	end
	return score
end
local function setValue(ids)
	local w = STAT_WEIGHTS[setting("pets.accessoryScoring")] or STAT_WEIGHTS.overall
	local total = { WalkSpeed = 0, Capacity = 0, TakeAmount = 0, SellValue = 0 }
	for _, id in ipairs(ids) do
		local a = AccessoryConfig.Accessories[id]
		local buffs = a and type(a.Buffs) == "table" and a.Buffs or {}
		local all = tonumber(buffs.All) or 0
		for _, stat in ipairs(ALL_STATS) do
			total[stat] = (total[stat] or 0) + all
		end
		for stat, amount in pairs(buffs) do
			if stat ~= "All" and type(amount) == "number" and total[stat] then
				total[stat] += amount
			end
		end
	end
	local v = 1
	for stat, amount in pairs(total) do
		v *= 1 + amount * (w[stat] or 0)
	end
	return v
end
local function bestSet(owned, size)
	local ids = {}
	for id, isOwned in pairs(owned or {}) do
		if isOwned and AccessoryConfig.Accessories[id] then
			table.insert(ids, id)
		end
	end
	local k = math.min(size, #ids)
	local best, bestV = {}, setValue({})
	local pick = {}
	local function rec(start, depth)
		if depth > k then
			local v = setValue(pick)
			if v > bestV then
				best, bestV = table.clone(pick), v
			end
			return
		end
		for i = start, #ids do
			pick[depth] = ids[i]
			rec(i + 1, depth + 1)
			pick[depth] = nil
		end
	end
	rec(1, 1)
	return best, bestV
end
