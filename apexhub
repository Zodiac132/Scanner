local function fmt(n)
	n = tonumber(n)
	if not n then
		return "?"
	end
	local units = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No" }
	local i = 1
	while math.abs(n) >= 1000 and i < #units do
		n = n / 1000
		i += 1
	end
	return (i == 1 and tostring(math.floor(n)) or ("%.2f%s"):format(n, units[i]))
end
local function note(s)
	table.insert(State.log, 1, os.date("%H:%M:%S ") .. s)
