			elseif RS:FindFirstChild("ClassSystem") or game.PlaceId == LOBBY_PLACE then
				lobby()
			else
				task.wait(5)
			end
		end)
		if not ok then
			say("error: " .. tostring(err))
			task.wait(5)
		end
	end
end)
return AFK
