local function surfaceAim(wx, wz)
	local c, PR = Config.PILE_CENTER, Config.PILE_RADIUS
	local x, z = wx - c.X, wz - c.Z
	local dug = 0
	if lastDig then
		local N = SurfaceMod.GRID_N
		local cell = 2 * PR / (N - 1)
		local col = math.clamp(math.floor((x + PR) / cell + 1.5), 1, N)
		local row = math.clamp(math.floor((z + PR) / cell + 1.5), 1, N)
		dug = lastDig[(row - 1) * N + col] or 0
	end
	return Vector3.new(wx, c.Y + math.max(SurfaceMod.baseHeight(x, z) - dug, 0), wz)
end
local function slotTntTarget(from)
