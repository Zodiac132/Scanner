				end
			end
		end
	end
	return best, bestN
end
local function tntTarget(from)
	if sweep.active and slotGeo then
		local best, n = slotTntTarget(from)
		if best then
			return best, n
		end
	end
	if sweep.active and sweep.grid then
		local R = math.max((lp:GetAttribute("TntBlastRadius") or Config.TNT_BLAST_RADIUS or 2.1) - 0.3, 1)
		local k = math.ceil(R / sweep.a)
		local best, bestN, bestD
		for idx = 1, #sweep.points do
			local p = sweep.points[idx]
			local d = flat(p.pos - from).Magnitude
			if not p.covered and d > 6 and d < 23 then
				local i0, j0 = sweepIndex(p.pos.X, p.pos.Z)
				local n = 0
				for i = i0 - k, i0 + k do
					for j = j0 - k, j0 + k do
						local q = sweep.grid[i .. "," .. j]
						if q and not q.covered and flat(q.pos - p.pos).Magnitude <= R then
							n += 1
						end
					end
				end
				if not bestN or n > bestN or (n == bestN and d < bestD) then
					local c, PR = Config.PILE_CENTER, Config.PILE_RADIUS
					local x, z = p.pos.X - c.X, p.pos.Z - c.Z
					local dug = 0
					if lastDig then
						local N = SurfaceMod.GRID_N
						local cell = 2 * PR / (N - 1)
						local col = math.clamp(math.floor((x + PR) / cell + 1.5), 1, N)
						local row = math.clamp(math.floor((z + PR) / cell + 1.5), 1, N)
						dug = lastDig[(row - 1) * N + col] or 0
					end
					local aim = Vector3.new(p.pos.X, c.Y + math.max(SurfaceMod.baseHeight(x, z) - dug, 0), p.pos.Z)
					if throwVelocity(from, aim) then
						best, bestN, bestD = aim, n, d
					end
				end
			end
		end
		if best then
			return best, bestN
		end
	end
	local stripping = needleSearching and next(genById) ~= nil
	if focus and not stripping then
		local p = nearbyHay()[1]
		return p and p.part.Position
	end
	local R = math.max(lp:GetAttribute("TntBlastRadius") or Config.TNT_BLAST_RADIUS or 2.1, 1)
	local grid, ring = {}, {}
	for _, p in ipairs(workspace.HaystackClient:GetChildren()) do
		local hid = p:GetAttribute("HayId")
		if hid and (not stripping or (genById[hid] or genLevel + 1) <= genLevel) then
			local pos = p.Position
			local key = math.floor(pos.X / R) .. "," .. math.floor(pos.Z / R)
			local cell = grid[key]
			if not cell then
				cell = {}
				grid[key] = cell
			end
			table.insert(cell, pos)
			local d = flat(pos - from).Magnitude
			if d > 6 and d < 26 then
				table.insert(ring, pos)
			end
		end
	end
	local best, score
	for i = 1, #ring, math.max(1, math.floor(#ring / 1500)) do
		local pos = ring[i]
		local cx, cz, n = math.floor(pos.X / R), math.floor(pos.Z / R), 0
		for dx = -1, 1 do
			for dz = -1, 1 do
				local cell = grid[(cx + dx) .. "," .. (cz + dz)]
				if cell then
					for _, q in ipairs(cell) do
						if (q - pos).Magnitude <= R then
							n += 1
						end
					end
				end
			end
		end
		if not score or n > score then
			best, score = pos, n
		end
	end
	return best, score
end
