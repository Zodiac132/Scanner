local function stripTarget(rank)
	local list = stripList()
	local start = math.min(rank, #list)
	for k = start, #list do
		if liveStrand(list[k].part) then
			return list[k].part
		end
	end
	for k = start - 1, 1, -1 do
		if liveStrand(list[k].part) then
			return list[k].part
		end
	end
	return nil
end
local function stripCandidates(target)
	local count = lp:GetAttribute("HayGrabCount") or 1
	local radius = lp:GetAttribute("HayGrabRadius") or 0
	if count <= 1 or radius <= 0 then
		return {}
	end
	local list = {}
	for _, e in ipairs(nearbyHay()) do
		local p = e.part
		local id = p:GetAttribute("HayId")
		if id and p ~= target and p.Parent then
			local d = (p.Position - target.Position).Magnitude
			if d <= radius then
				table.insert(list, { id = id, d = d, g = genById[id] or (genLevel + 1) })
			end
		end
	end
	table.sort(list, function(a, b)
		if a.g ~= b.g then
			return a.g < b.g
		end
		return a.d < b.d
	end)
